<?xml version="1.0"?>
<launch>
  <include file="$(find agribot_navigation)/launch/kinematics_control.launch" />
  <include file="$(find agribot_navigation)/launch/move_base.launch" />

  <node name="navigation_manager_node" pkg="agribot_navigation" type="navigation_manager_node" output="screen">
    <rosparam command="load" file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/navigation_manager_params.yaml" />
  </node>
</launch>
