<launch>
  <arg name="cmd_vel_arbiter_starting_state" default="stop" />

  <node name="kinematics_control_node" pkg="agribot_navigation" type="kinematics_control">
    <rosparam file="$(find agribot_navigation)/param/kinematics_control_params.yaml" command="load" />
  </node>

  <node name="cmd_vel_arbiter_node" pkg="agribot_navigation" type="cmd_vel_arbiter_node">
    <rosparam file="$(find agribot_navigation)/param/teleop_params.yaml" command="load" />
    <param name="starting_state" value="$(arg cmd_vel_arbiter_starting_state)" type="str" />
    <param name="timeout" value="1" type="double"/>
  </node>

</launch>
