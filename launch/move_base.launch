<launch>

  <arg name="cmd_vel_topic" default="/cmd_vel_navigation" />
  <arg name="odom_topic" default="/agribot/odom/local" />
  <arg name="lidar_topic" default="/agribot/obstacle_detection/front/3d/lidar/point_cloud/filtered_objects" />

  <node pkg="move_base" type="move_base" name="move_base" respawn="false" output="screen">

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_costmap_global_params.yaml" command="load" />
    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_costmap_local_params.yaml" command="load" />
    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_planner_global_params.yaml" command="load" />
    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_planner_local_params.yaml" command="load" />
    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_params.yaml" command="load" />

    <remap from="cmd_vel" to="$(arg cmd_vel_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
    <remap from="line_left" to="/agribot/obstacle_detection/front/left_row" />
    <remap from="line_right" to="/agribot/obstacle_detection/front/right_row" />
    <remap from="/lidar_scan" to="$(arg lidar_topic)"/>
  </node>
</launch>
