<launch>

  <arg name="cmd_vel_topic" default="/cmd_vel_navigation" />
  <arg name="odom_topic" default="/agribot/odom/local" />
  <arg name="lidar_topic" default="/bumper/front/lidar/obstacles" />

  <node pkg="move_base" type="move_base" name="move_base" respawn="false" output="screen">

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/costmap_common_params.yaml" command="load" ns="global_costmap" />

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/costmap_common_params.yaml" command="load" ns="local_costmap" />

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/costmap_global_params.yaml" command="load" />

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/costmap_local_params.yaml" command="load" />

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/base_global_planner_params.yaml" command="load" />

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/base_local_planner_params.yaml" command="load" />

    <rosparam file="$(env AGRIBOT_HOME)/agribot/configs/base/navigation/move_base_params.yaml" command="load" />

    <param name="base_local_planner" value="agribot_navigation/AgribotPlannerROS" />
    <param name="base_global_planner" value="agribot_navigation/WaypointGlobalPlanner" />

    <remap from="cmd_vel" to="$(arg cmd_vel_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
    <remap from="/lidar_scan" to="$(arg lidar_topic)"/>
  </node>
</launch>
